# Obligatoria: URL PostgreSQL/Supabase compatible con psycopg 3.
# Ejemplo sin credenciales: postgresql+psycopg://<usuario>:<clave>@<host>:5432/<base>
# Define el valor privado en .env; nunca guardes credenciales reales en esta plantilla.
DATABASE_URL=
# Docker/local: ruta en el host al CA oficial de Supabase, montado como secreto de solo lectura.
# Para runtimes sin montaje, puede configurarse SUPABASE_CA_CERT con el PEM completo.
SUPABASE_CA_FILE=
# Alternative for runtimes without file mounts (for example Vercel): set the complete
# official CA PEM as a secret environment variable. Never paste the certificate here.
SUPABASE_CA_CERT=

PORT=5000
MAX_IMAGE_MB=4
# Orígenes CORS locales. En Vercel solo hace falta configurarlos para un frontend de otro origen.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000
# Límite de solicitudes de predicción por IP. memory:// cuenta por proceso.
PREDICTION_RATE_LIMIT="10 per minute"
RATE_LIMIT_STORAGE_URI=memory://
# 0 desactiva confianza en cabeceras de proxy. Configura el número exacto solo tras verificar el proxy.
TRUSTED_PROXY_HOPS=0
