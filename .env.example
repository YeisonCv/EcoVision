# Obligatoria: URL PostgreSQL/Supabase compatible con psycopg 3.
# Ejemplo sin credenciales: postgresql+psycopg://<usuario>:<clave>@<host>:5432/<base>
# Define el valor privado en .env; nunca guardes credenciales reales en esta plantilla.
DATABASE_URL=
# Ruta en el host al CA descargado desde la sección Database Settings de Supabase.
# Obligatorio para conexiones remotas; el archivo se monta como secreto de solo lectura.
SUPABASE_CA_FILE=

PORT=5000
MAX_IMAGE_MB=10
# Orígenes CORS locales; en despliegue, sustituye por el origen público exacto.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000
# El almacenamiento en memoria sirve para una instancia/proceso; configure un almacén compartido al escalar.
RATE_LIMIT_STORAGE_URI=memory://
# 0 desactiva confianza en cabeceras de proxy. Configura el número exacto solo tras verificar el proxy.
TRUSTED_PROXY_HOPS=0
